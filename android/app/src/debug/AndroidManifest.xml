<?xml version="1.0" encoding="utf-8"?>
<!-- デバッグビルドにだけ載る、通知確認用のトリガー。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.infomaster.DEBUG_RUN_WORKER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
