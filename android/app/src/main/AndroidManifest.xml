<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13 以降、通知には実行時の許可が要る -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 朝の決まった時刻に起こすため。取れなければ不正確版に落とす -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 再起動でアラームが消えるので仕掛け直す -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      省電力の除外をアプリから直接お願いするため。
      これが無いと一覧画面を開くことしかできず、設定し損ねやすい。
      （Play ストアでは用途が制限される権限だが、このアプリは自分用で
       ストア配布しないため問題ない）
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".InfomasterApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Infomaster">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Infomaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 朝のアラームの受け口。アプリが起動していなくても呼ばれる -->
        <receiver
            android:name=".work.DigestAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".work.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
